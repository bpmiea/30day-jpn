{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "30day-jpn",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/downloads/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "30day-jpn-db",
      "database_id": "8b0c9042-54aa-4e5e-b0a1-779da217e6d4",
      "migrations_dir": "migrations",
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "routes": [
    {
      "pattern": "jpn.mux1.tech",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
